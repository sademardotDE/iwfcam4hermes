{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "iwfcam4hermes",
  "version": "0.2.0",
  "description": "WiFi camera management plugin (iWFCam & Z-IOT) with standard camera streaming GUI",
  "author": {
    "name": "sademar"
  },
  "license": "MIT",
  "repository": "https://github.com/sademardotDE/iwfcam4hermes",
  "keywords": ["camera", "streaming", "iwfcam", "ziot", "webcam", "rtsp"],
  "extensions": {
    "com.nousresearch.hermes": {
      "entry_point": "hermes_plugin:create_plugin",
      "config_schema": "config.example.json",
      "python_dependencies": ["requests", "websocket-client", "opencv-python", "pillow"],
      "commands": ["list", "show", "stream-url", "snapshot-url", "snapshot"],
      "features": ["camera_management", "snapshot_capture", "stream_proxy", "stun_discovery", "heartbeat", "gui_streaming"]
    }
  }
}